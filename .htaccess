# ===================================================
# .htaccess - Chase Healthcare & Wellness
# ===================================================

# --- Custom 404 Error Page ---
ErrorDocument 404 /404.html

# --- Enable Rewrite Engine ---
RewriteEngine On

# --- Force HTTPS ---
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Remove www (canonical) ---
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# --- Remove .html extension (clean URLs) ---
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# --- Enable GZIP Compression ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>

# --- Browser Caching ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --- Security Headers ---
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- MIME Types & Video Streaming (CRITICAL FOR MOBILE) ---
<IfModule mod_mime.c>
    AddType video/mp4 .mp4
    AddType video/webm .webm
    AddType video/ogg .ogv
</IfModule>

# Disable mod_deflate/gzip for videos to ensure byte-range requests work on mobile
SetEnvIfNoCase Request_URI \.(?:mp4|webm|ogv)$ no-gzip dont-vary

<IfModule mod_headers.c>
    <FilesMatch "\.(mp4|webm|ogv)$">
        Header set Accept-Ranges bytes
        Header unset Cache-Control
        Header add Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        Header unset Pragma
        Header unset Expires
    </FilesMatch>
</IfModule>

# --- Prevent Directory Listing ---
Options -Indexes
